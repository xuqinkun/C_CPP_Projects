{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc.exe build active file",
            "type": "shell",
            "command": "mkdir build 2>nul & gcc -fdiagnostics-color=always -g -O0 -fdebug-prefix-map=/cygdrive/d=D: -fdebug-prefix-map=/cygdrive/D=D: ${fileBasename} -o build\\${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译到 build 目录（相对路径，避免 C&CPP 中的 & 拆命令）"
        }
    ]
}
